# branch-review.config — commit this file at the root of the project's refs/meta/config.
# A file in a parent project (All-Projects included) applies to all its descendants; a child's
# file overrides the inherited keys one by one (docs/configuration.md#inheritance).
[branchReview]
	# Explicit opt-in, inherited by child projects; a child opts out with enabled = false.
	enabled = true
	# Fully qualified target branch of every review Change (must exist where it is used).
	targetBranch = refs/heads/master
	# Source branches reviewed through this plugin. Exact refs, or a prefix ending in '*'
	# (which also matches further '/'). Repeat the key to add patterns; they are ORed.
	sourceBranchPattern = refs/heads/feature/*
	sourceBranchPattern = refs/heads/bugfix/*
	# Exclusions win over source patterns.
	excludeBranchPattern = refs/heads/feature/private/*
	# Delete the source branch after a successful Submit, only if it still points at the
	# submitted state and the submitter may delete it. Off by default.
	deleteSourceBranchOnSubmit = false
	# Commit content edits made in Gerrit (inline edits, uploads to the Change) back onto the
	# source branch, as the editor and only if the editor may push to the branch. Default true;
	# false pauses synchronization until the edit is incorporated by hand.
	syncEditsToBranch = true
	# New Changes start Work in Progress (default). false = created ready for review. Only the
	# initial state: WIP/Ready changes made in Gerrit afterwards are always kept.
	workInProgress = true

# Optional: route some branches to other targets. The most specific matching pattern wins; the
# [branchReview] route above is the fallback. Targets must exist, and a target cannot have source
# branches below it (refs/heads/dev and refs/heads/dev/x cannot coexist in Git).
#[target "refs/heads/develop"]
#	sourceBranchPattern = refs/heads/dev/*
#	sourceBranchPattern = refs/heads/*/feat/*
#[target "refs/heads/runtime"]
#	sourceBranchPattern = refs/heads/run/*
#	deleteSourceBranchOnSubmit = true
